ENTRY(__rp1_reset0)
EXTERN(__rp1_reset0 __rp1_reset1)
MEMORY {
  SRAM  (rwx) : ORIGIN = 0x20000000, LENGTH = 48K
  ISRAM (rwx) : ORIGIN = 0x10000000, LENGTH = 8K
  DSRAM (rwx) : ORIGIN = 0x10002000, LENGTH = 8K
  LINK  (rw)  : ORIGIN = 0x2000c000, LENGTH = 0x3f00
}
PHDRS { text PT_LOAD; isram PT_LOAD; code PT_LOAD; data PT_LOAD; shared PT_LOAD; }
SECTIONS {
  .vectors ORIGIN(SRAM) : ALIGN(512) {
    __vectors0 = .; KEEP(*(.vectors.proc0));
    . = ALIGN(512); __vectors1 = .; KEEP(*(.vectors.proc1));
  } > SRAM :text
  .boot 0x20000400 : { KEEP(*(.text.rp1_reset)); } > SRAM :text
  /* Before .text, which is in its own PT_LOAD so the load images do not overlap: an input
     section goes to the first rule that matches it, so the automatic plan (function sections
     .text.<symbol>) must be seen before .text's wildcard.
     rp1-isram-auto.x is generated by rp1-build: empty, or the plan of `cargo rp1 build`. */
  .isram : ALIGN(4) {
    __sisram = .; *(.isram .isram.*);
    INCLUDE rp1-isram-auto.x
    . = ALIGN(4); __eisram = .;
  } > ISRAM AT> SRAM :isram
  __siisram = LOADADDR(.isram);
  /* #[cold]: kept in shared SRAM; automatic ISRAM placement stops here. */
  .text.cold : ALIGN(4) { __scold = .; *(.text.rp1_cold .text.rp1_cold.*); __ecold = .; } > SRAM :code
  .text : ALIGN(4) { *(.text .text.*); *(.rodata .rodata.*); . = ALIGN(4); } > SRAM :code
  .ARM.exidx : { *(.ARM.exidx*); } > SRAM :code
  .data : ALIGN(8) {
    __sdata = .; *(.data .data.*); *(.sdata .sdata.*); *(.got .got.*);
    . = ALIGN(4); __edata = .;
  } > DSRAM AT> SRAM :data
  __sidata = LOADADDR(.data);
  /* Not part of any PT_LOAD: loaders zero p_memsz-p_filesz at p_paddr, which would land in shared SRAM.
     Each core zeroes its own DSRAM copy in startup. */
  .bss (NOLOAD) : ALIGN(8) { __sbss = .; *(.bss .bss.*); *(COMMON); . = ALIGN(8); __ebss = .; } > DSRAM :NONE
  .shared : ALIGN(8) { *(.shared .shared.*); . = ALIGN(8); __image_end = .; } > SRAM :shared
  .link ORIGIN(LINK) (NOLOAD) : { __link_start = .; . += LENGTH(LINK); __link_end = .; } > LINK :NONE
  .note.rp1 0 (INFO) : { KEEP(*(.note.rp1)); } :NONE
  .rp1.dtbo 0 (INFO) : { KEEP(*(.rp1.dtbo)); } :NONE
  /DISCARD/ : { *(.ARM.extab*); *(.eh_frame*); }
}
ASSERT(SIZEOF(.isram) <= 8192, "ISRAM budget exceeded")
ASSERT(__ebss + MAX(__stack_size0, __stack_size1) <= 0x10004000, "DSRAM + stack budget exceeded")
ASSERT(__image_end <= 0x2000c000, "shared SRAM image exceeds 48 KiB")
/* Fixed-address scratch: every raw shared-SRAM address the firmware uses (link page, SCMI
   shmem, lab request words) must be at or above this floor; below it everything belongs to the
   image, whose size changes with the code. Shared scratch below the floor must be a .shared
   static so the linker places it. `cargo rp1 check` rejects code constants in the unallocated gap
   between __image_end and this floor. */
__rp1_fixed_scratch_floor = ORIGIN(LINK);
ASSERT(__image_end <= __rp1_fixed_scratch_floor, "image overlaps the fixed-address scratch floor (ORIGIN(LINK))")
ASSERT(__link_end == 0x2000ff00, "link page overlaps ABI reservation")
